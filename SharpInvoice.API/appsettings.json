{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=SharpInvoiceDb;Trusted_Connection=true;MultipleActiveResultSets=true",
    "StorageConnection": ""
  },
  "AppSettings": {
    "Jwt": {
      "Secret": "YourSuperSecretKeyThatIsAtLeast32CharactersLong!",
      "Issuer": "SharpInvoice",
      "Audience": "SharpInvoiceUsers",
      "AccessTokenExpirationMinutes": 60,
      "RefreshTokenExpirationDays": 7
    },
    "Authentication": {
      "Google": {
        "ClientId": "",
        "ClientSecret": ""
      }
    },
    "AllowedOrigins": [
      "https://localhost:3000",
      "http://localhost:3000",
      "https://localhost:5001",
      "http://localhost:5000"
    ]
  },
  "StripeSettings": {
    "PublishableKey": "",
    "SecretKey": "",
    "WebhookSecret": ""
  },
  "EmailSettings": {
    "From": "",
    "SmtpHost": "smtp.sendgrid.net",
    "SmtpPort": 587,
    "SmtpUser": "apikey",
    "SmtpPassword": ""
  },
  "KeyVault": {
    "Url": ""
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Enrichers.Environment", "Serilog.Enrichers.Thread" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithEnvironmentName", "WithThreadId" ],
    "Properties": {
      "Application": "SharpInvoice.Web"
    }
  },
  "AllowedHosts": "*",
  "EnableSensitiveDataLogging": false
}